# Copy to .env (PowerShell: Copy-Item .env.example .env) and edit. Never commit .env.

# --- Database ---
# Used by docker compose (builds DATABASE_URL for the backend container)
DB_USER=ptoshield
DB_PASSWORD=change-me
DB_NAME=ptoshield
# Used when running the backend without Docker
DATABASE_URL=postgresql://ptoshield:change-me@localhost:5432/ptoshield

# --- Auth ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Must be 32+ chars; placeholders are rejected unless APP_ENV=development or test.
APP_ENV=development
SECRET_KEY=change-me-placeholder-replace-with-48-random-chars
# Browser origins allowed by CORS (JSON list); first is used for redirects.
# Defaults: http://localhost:5173 (local backend), http://localhost:3000 (docker compose)
# ALLOWED_ORIGINS=["http://localhost:5173"]
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
GOOGLE_CLIENT_ID=your-client-id
GOOGLE_CLIENT_SECRET=your-secret

# --- Optional: leave blank to use fallbacks ---
# OpenAI blank = template fallback (no AI calls)
OPENAI_API_KEY=
OPENAI_MODEL=
# Dodo blank = demo mode (no real payments)
DODO_API_KEY=
DODO_WEBHOOK_SECRET=
DODO_PRODUCT_ID_PRO=
DODO_PRODUCT_ID_TEAM=
# DODO_BASE_URL blank = live host; set https://test.dodopayments.com for test keys
DODO_BASE_URL=
# SMTP blank = emails are logged only
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- Frontend ---
VITE_API_URL=http://localhost:8000
